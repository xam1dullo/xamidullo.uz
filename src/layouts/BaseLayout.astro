---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Terminal from "../components/Terminal.astro";
import { SITE_URL } from "../lib/blog";

interface Props {
  title: string;
  description: string;
  /** Path of the page, e.g. "/blog/". Used for canonical and og:url. */
  path?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** "home" shows the full interactive header; "page" hides language toggle on Uzbek-only pages. */
  variant?: "home" | "page";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  path = "/",
  ogType = "website",
  ogImage = "https://avatars.githubusercontent.com/u/74096482?v=4",
  jsonLd,
  variant = "page",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
---

<!doctype html>
<html lang="uz" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080c" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        var storedTheme = localStorage.getItem("xh-theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.dataset.theme = storedTheme;
        } else {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (e) {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Xamidullo Xudoyberdiyev · Blog" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="uz_UZ" />
    <meta property="og:site_name" content="xamidullo.uz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Asosiy tarkibga o‘tish</a>

    <Header variant={variant} currentPath={path} />

    <slot />

    <Terminal />

    <script>
      import { initTheme } from "../scripts/theme";
      initTheme();
    </script>
  </body>
</html>
