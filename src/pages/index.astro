---
import { personSchema } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/Hero.astro";
import Metrics from "../components/Metrics.astro";
import Principles from "../components/Principles.astro";
import Capabilities from "../components/Capabilities.astro";
import Projects from "../components/Projects.astro";
import ProjectDrawer from "../components/ProjectDrawer.astro";
import Timeline from "../components/Timeline.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Knowledge from "../components/Knowledge.astro";
import TelemetryBar from "../components/TelemetryBar.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout
  title="Xamidullo Xudoyberdiyev · Senior Software Engineer"
  description="Xamidullo Xudoyberdiyev, Ucell’da Senior Software Engineer. Backend arxitektura, yuqori yuklamali mikroservislar, ma’lumotlar bazasi optimizatsiyasi, DevOps va Node.js mentorligi."
  path="/"
  jsonLd={personSchema}
  variant="home"
>
  <main id="main">
    <Hero />
    <Metrics />
    <Principles />
    <Capabilities />
    <Projects />
    <Timeline />
    <LatestPosts />
    <Knowledge />
  </main>

  <TelemetryBar />
  <Contact />

  <!-- Interactive Overlays -->
  <ProjectDrawer />

  <script>
    import { initMotion } from "../scripts/motion";
    import { initSystemCanvas } from "../scripts/system-canvas";
    import { initI18n } from "../scripts/i18n";
    import { initSpotlight } from "../scripts/spotlight";

    function bootstrap() {
      initI18n();
      initSystemCanvas();
      initMotion();
      initSpotlight();
    }

    // Initialize interactive Canvas, GSAP Motion, i18n, and Spotlight
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootstrap);
    } else {
      bootstrap();
    }
  </script>
</BaseLayout>
