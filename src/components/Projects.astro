---
import {
  ArrowRight02Icon,
  ArrowUpRight01Icon,
  HierarchySquare01Icon,
} from "@hugeicons/core-free-icons";
import { defaultContent } from "../data/portfolio";
import HugeIcon from "./HugeIcon.astro";

const { projects, archiveProjects, workHeading } = defaultContent;
---

<section class="work shell reveal-on-scroll" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow" data-i18n="workHeading.eyebrow">{workHeading.eyebrow}</p>
      <h2 id="work-title" data-i18n="workHeading.title">{workHeading.title}</h2>
    </div>
    <p data-i18n="workHeading.summary">{workHeading.summary}</p>
  </div>

  <div class="project-bento-list">
    {
      projects.map((project, index) => {
        const domain = project.url.replace(/^https?:\/\//, "");
        const cleanType = project.type.replace(/^\d+\s*·\s*/, "");
        return (
          <article class="project-card bento-card" data-project-id={project.id}>
            <div class="project-card-info">
              <div class="project-top-meta">
                <span class="project-idx-pill">0{index + 1}</span>
                <span class="project-type-text">{cleanType}</span>
                <a
                  class="project-domain-badge"
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="live-dot" aria-hidden="true"></span>
                  {domain}
                  <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
                </a>
              </div>

              <div class="project-title-group">
                <h3>{project.name}</h3>
                <p class="project-description">{project.description}</p>
              </div>

              <ul class="project-stack" aria-label={`${project.name} texnologiyalari`}>
                {project.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              <div class="project-cta-group">
                {project.architecture && (
                  <button
                    type="button"
                    class="button-case-study button-magnetic"
                    data-open-drawer={project.id}
                    aria-label={`${project.name} arxitekturasini o'rganish`}
                  >
                    <HugeIcon icon={HierarchySquare01Icon} size={16} anim="layers" class="cs-icon" />
                    <span class="cs-btn-text" data-i18n="workHeading.caseStudyBtn">
                      {workHeading.caseStudyBtn}
                    </span>
                  </button>
                )}
                <a
                  class="project-arrow button-magnetic"
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} saytiga o'tish`}
                >
                  <HugeIcon icon={ArrowUpRight01Icon} size={18} anim="arrow-up-right" />
                </a>
              </div>
            </div>

            {project.architecture && (
              <div class="project-blueprint" aria-label={`${project.name} arxitektura sxemasi`}>
                <div class="blueprint-bar">
                  <span class="bp-title">// ARCHITECTURE TOPOLOGY</span>
                  <span class="bp-status">PRODUCTION · VERIFIED</span>
                </div>

                <div class="blueprint-flow">
                  {project.architecture.diagramNodes.map((node, idx, arr) => (
                    <div class="bp-node-step">
                      <div class="bp-node">
                        <span class="bp-node-idx">N0{idx + 1}</span>
                        <strong class="bp-node-name">{node.label}</strong>
                        <span class="bp-node-role">{node.role}</span>
                      </div>
                      {idx < arr.length - 1 && (
                        <span class="bp-connector" aria-hidden="true">
                          <HugeIcon icon={ArrowRight02Icon} size={16} anim="arrow-right" />
                        </span>
                      )}
                    </div>
                  ))}
                </div>

                <div class="blueprint-metrics">
                  {project.architecture.metrics.map((m) => (
                    <div class="bp-metric-box">
                      <strong class="bp-metric-val">{m.value}</strong>
                      <span class="bp-metric-lbl">{m.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </article>
        );
      })
    }
  </div>

  <div class="archive-block">
    <div class="archive-head">
      <div>
        <h3 data-i18n="workHeading.archiveTitle">{workHeading.archiveTitle}</h3>
        <p data-i18n="workHeading.archiveSubtitle">{workHeading.archiveSubtitle}</p>
      </div>
      <span class="archive-count">// +03 LIVE PRODUCTION SYSTEMS</span>
    </div>

    <div class="archive-grid">
      {
        archiveProjects.map((item) => {
          const domain = item.url.replace(/^https?:\/\//, "");
          return (
            <a
              class="archive-card"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="archive-card-top">
                <span class="archive-mark">{item.mark}</span>
                <span class="archive-domain">
                  <span class="live-dot" aria-hidden="true"></span>
                  {domain}
                  <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
                </span>
              </div>
              <div class="archive-card-body">
                <h4>{item.name}</h4>
                <p class="archive-meta">{item.meta}</p>
                <p class="archive-desc">{item.description}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-bento-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    --mouse-x: -9999px;
    --mouse-y: -9999px;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: stretch;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: 1.35rem;
    border: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgb(var(--surface-raised-rgb) / 0.65),
      rgb(var(--surface-rgb) / 0.9)
    );
    box-shadow:
      inset 0 1px 0 var(--border-inset),
      0 1.25rem 3rem -1.25rem rgb(var(--shadow-rgb) / 0.5);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .project-card::before,
  .archive-card::before {
    position: absolute;
    inset: 0;
    content: "";
    background: radial-gradient(
      480px circle at var(--mouse-x) var(--mouse-y),
      rgb(var(--signal-rgb) / 0.12),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 250ms ease;
    pointer-events: none;
    z-index: 0;
  }

  .project-card:hover::before,
  .archive-card:hover::before {
    opacity: 1;
  }

  .project-card:hover {
    border-color: rgb(var(--signal-rgb) / 0.45);
    transform: translateY(-0.15rem);
  }

  .project-card > *,
  .archive-card > * {
    position: relative;
    z-index: 1;
  }

  .project-card-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
  }

  .project-top-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .project-idx-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.55rem;
    border-radius: 0.4rem;
    background: rgb(var(--signal-rgb) / 0.14);
    border: 1px solid rgb(var(--signal-rgb) / 0.35);
    color: var(--signal);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .project-type-text {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-domain-badge {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line-bright);
    background: rgb(var(--canvas-rgb) / 0.65);
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.72rem;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .project-domain-badge:hover {
    border-color: var(--signal);
    color: var(--signal-hover);
  }

  .live-dot {
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 0.4rem var(--accent-emerald);
  }

  .project-title-group h3 {
    margin: 0 0 0.6rem;
    color: var(--ink);
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .project-description {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .project-cta-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block-start: 0.35rem;
  }

  .button-case-study {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.55rem 1.05rem;
    border-radius: 0.65rem;
    background: rgb(var(--signal-rgb) / 0.12);
    border: 1px solid rgb(var(--signal-rgb) / 0.38);
    box-shadow: inset 0 1px 0 var(--border-inset);
    color: var(--signal-hover);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 120ms ease;
  }

  .button-case-study:hover {
    background: var(--signal-dim);
    color: var(--on-accent);
    border-color: var(--signal);
  }

  .button-case-study:active {
    transform: scale(0.98);
  }

  .cs-icon {
    flex: none;
  }

  /* Right Side: Visual Architecture Blueprint Panel */
  .project-blueprint {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem;
    border-radius: 1rem;
    border: 1px solid var(--line-bright);
    background:
      radial-gradient(24rem 14rem at 100% 0%, rgb(var(--signal-rgb) / 0.12), transparent 70%),
      linear-gradient(to right, rgb(var(--ink-rgb) / 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--ink-rgb) / 0.025) 1px, transparent 1px),
      rgb(var(--canvas-rgb) / 0.75);
    background-size: 100% 100%, 1.5rem 1.5rem, 1.5rem 1.5rem, 100% 100%;
    box-shadow: inset 0 1px 0 var(--border-inset);
  }

  .blueprint-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .bp-title {
    color: var(--ink-faint);
  }

  .bp-status {
    color: var(--accent-emerald);
    font-weight: 600;
  }

  .blueprint-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .bp-node-step {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bp-node {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid rgb(var(--signal-rgb) / 0.3);
    background: rgb(var(--surface-raised-rgb) / 0.9);
    box-shadow: inset 0 1px 0 var(--border-inset);
    font-family: var(--mono);
  }

  .bp-node-idx {
    font-size: 0.62rem;
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }

  .bp-node-name {
    font-size: 0.74rem;
    color: var(--ink);
    font-weight: 700;
  }

  .bp-node-role {
    font-size: 0.68rem;
    color: var(--ink-faint);
  }

  .bp-connector {
    display: inline-flex;
    color: var(--signal);
    opacity: 0.75;
  }

  .blueprint-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--line);
  }

  .bp-metric-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    background: rgb(var(--surface-rgb) / 0.75);
  }

  .bp-metric-val {
    color: var(--signal-hover);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .bp-metric-lbl {
    color: var(--ink-faint);
    font-size: 0.7rem;
    line-height: 1.3;
  }

  /* Archive Live Systems Grid */
  .archive-block {
    margin-block-start: clamp(3rem, 6vw, 4.5rem);
    padding-block-start: clamp(2rem, 4vw, 3rem);
    border-block-start: 1px solid var(--line);
  }

  .archive-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.75rem;
  }

  .archive-head h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .archive-head p {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .archive-count {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--signal);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
  }

  .archive-card {
    --mouse-x: -9999px;
    --mouse-y: -9999px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 1.15rem;
    border: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgb(var(--surface-raised-rgb) / 0.6),
      rgb(var(--surface-rgb) / 0.85)
    );
    box-shadow:
      inset 0 1px 0 var(--border-inset),
      0 1rem 2rem -1rem rgb(var(--shadow-rgb) / 0.45);
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .archive-card:hover {
    border-color: rgb(var(--signal-rgb) / 0.45);
    transform: translateY(-0.18rem);
  }

  .archive-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .archive-mark {
    display: inline-grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 0.55rem;
    background: rgb(var(--signal-rgb) / 0.14);
    border: 1px solid rgb(var(--signal-rgb) / 0.35);
    color: var(--signal);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .archive-domain {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-bright);
    background: rgb(var(--canvas-rgb) / 0.6);
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .archive-card-body h4 {
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .archive-meta {
    margin: 0.3rem 0 0.65rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--signal);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .archive-desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  @media (max-width: 68rem) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .archive-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .blueprint-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
