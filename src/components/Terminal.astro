---
import { Cancel01Icon, ComputerTerminal01Icon } from "@hugeicons/core-free-icons";
import HugeIcon from "./HugeIcon.astro";
---

<dialog id="cli-terminal" class="terminal-modal" aria-labelledby="terminal-title">
  <div class="terminal-shell">
    <div class="terminal-bar">
      <span class="terminal-title" id="terminal-title">
        <HugeIcon icon={ComputerTerminal01Icon} size={14} anim="terminal" />
        xamidullo@systems: ~ (zsh)
      </span>
      <button type="button" class="terminal-close-btn" id="terminal-close-btn" aria-label="Terminalni yopish">
        <HugeIcon icon={Cancel01Icon} size={16} anim="spin" />
      </button>
    </div>

    <div class="terminal-screen" id="terminal-screen">
      <div class="terminal-banner">
        <pre class="ascii-art" aria-hidden="true">{`__  __ _   _ / ___ \\ / ___| _   _ ___ 
\\ \\/ /| | | / /   \\ \\\\___ \\| | | / __|
 >  < | |_| | |   | | ___) | |_| \\__ \\
/_/\\_\\|_|_|_|\\ \\_/_/ |____/ \\__, |___/
              \\____/        |___/     `}</pre>
        <p class="welcome-text">
          <strong>XH/SYSTEMS CLI v2.6.0</strong> · Tizim ma’lumotlari va buyruqlar konsoli.<br />
          Mavjud buyruqlarni ko‘rish uchun <span class="term-highlight">help</span> deb yozing.
        </p>
      </div>

      <div class="terminal-log" id="terminal-log"></div>

      <form class="terminal-input-row" id="terminal-form" autocomplete="off">
        <span class="term-prompt" aria-hidden="true">visitor@systems:~$</span>
        <input
          type="text"
          id="terminal-input"
          class="terminal-input"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          aria-label="Terminal buyrug'i"
        />
      </form>
    </div>

    <div class="terminal-quick-cmds">
      <span>Tezkor buyruqlar:</span>
      <button type="button" class="quick-cmd" data-cmd="help">help</button>
      <button type="button" class="quick-cmd" data-cmd="whoami">whoami</button>
      <button type="button" class="quick-cmd" data-cmd="values">values</button>
      <button type="button" class="quick-cmd" data-cmd="skills">skills</button>
      <button type="button" class="quick-cmd" data-cmd="projects">projects</button>
      <button type="button" class="quick-cmd" data-cmd="blog">blog</button>
      <button type="button" class="quick-cmd" data-cmd="experience">experience</button>
      <button type="button" class="quick-cmd" data-cmd="ping">ping</button>
      <button type="button" class="quick-cmd" data-cmd="clear">clear</button>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById("cli-terminal");
    const closeBtn = document.getElementById("terminal-close-btn");
    const form = document.getElementById("terminal-form");
    const input = document.getElementById("terminal-input");
    const log = document.getElementById("terminal-log");
    const screen = document.getElementById("terminal-screen");
    const openBtn1 = document.getElementById("open-terminal-btn");
    const openBtn2 = document.getElementById("hero-terminal-btn");

    if (!dialog || !input || !log) return;

    const commands = {
      help: () => `
Mavjud buyruqlar ro‘yxati:
  <span class="term-green">whoami</span>      · Muhandis haqida ma’lumot
  <span class="term-green">values</span>      · Ish tamoyillari va yondashuv
  <span class="term-green">skills</span>      · Backend, ma’lumotlar bazasi va DevOps steki
  <span class="term-green">projects</span>    · Production loyihalar ro‘yxati (6 ta)
  <span class="term-green">blog</span>        · Texnik maqolalar (/blog/)
  <span class="term-green">experience</span>  · Mehnat faoliyati va ta’lim
  <span class="term-green">ping</span>        · Tizim javob vaqtini tekshirish
  <span class="term-green">contact</span>     · Aloqa kanallari (Telegram, Email, LinkedIn)
  <span class="term-green">clear</span>       · Konsol tarixini tozalash
  <span class="term-green">exit</span>        · Terminalni yopish
`,
      whoami: () => `
<strong>Xamidullo Xudoyberdiyev Ulug‘bek o‘g‘li</strong>
Lavozim: Senior Software Engineer · Ucell
Mentorlik: Node.js Teacher · Najot Ta’lim (2024-yildan)
Ta’lim: Farg‘ona Politexnika Instituti (Mechanical Engineering, B.S. 2019 → 2023)
Manzil: Toshkent, O‘zbekiston
Shior: "build · learn · serve" · Halol mehnat, puxta muhandislik.
`,
      values: () => `
<strong>[Ish Tamoyili va Yondashuv]</strong>
“Halol niyat, aniq mas’uliyat va puxta muhandislik uzoq umr ko‘radigan dasturiy mahsulotning asosidir.”
01. <strong>Halollik</strong> · Qaror, muddat va risklarni ochiq aytish
02. <strong>Mas’uliyat</strong> · Loyihalashdan production barqarorligigacha javobgarlik
03. <strong>Amaliy qiymat</strong> · Foydalanuvchi ishini tezlashtiradigan o‘zgarishlar
04. <strong>Intizom va o‘rganish</strong> · Test, monitoring, dokumentatsiya va mentorlik
`,
      skills: () => `
<strong>[Texnik Stek]</strong>
• <em>Backend:</em> TypeScript, Node.js, NestJS, Deno, Go, grammY, Prisma, WebSockets
• <em>Databases:</em> PostgreSQL, Oracle SQL, MongoDB, Redis
• <em>Infra & DevOps:</em> Docker, Nginx, Linux, CI/CD, AWS
• <em>Quality:</em> Testing (Playwright/Unit), Monitoring, Clean Code, Architecture, Mentoring
`,
      projects: () => `
<strong>[Production Loyihalar (6)]</strong>
1. <strong>SAG Flooring</strong>  · Commerce platform (Next.js, NestJS, PostgreSQL, Docker, Redis) · sagflooring.uz
2. <strong>Automaktab</strong>    · Avtomaktab boshqaruv tizimi (Full-stack, Node.js, PostgreSQL) · automaktab.uz
3. <strong>Burro Arab</strong>    · Arab tili ta’lim va audio streaming platformasi · burroarab.uz
4. <strong>AutoDriver</strong>    · Full-stack · DevOps · Mobile-first · autodriver.uz
5. <strong>Tilchi</strong>        · Education · Content · Platform · tilchi.uz
6. <strong>Chortoqliklar</strong> · Community · Full-stack · Ownership · chortoqliklar.uz
`,
      blog: () => `
<strong>[Texnik Maqolalar · <a href="/blog/">/blog/</a>]</strong>
1. <a href="/blog/postgresql-explain-analyze/">PostgreSQL’da sekin so‘rovni topish: EXPLAIN ANALYZE amaliyoti</a> (PostgreSQL, Performance)
2. <a href="/blog/nodejs-streams-backpressure/">Node.js’da stream va backpressure: katta fayllarni uzatish</a> (Node.js, Performance)
3. <a href="/blog/docker-production-images/">Production uchun Docker image: multi-stage build va xavfsizlik</a> (Docker, DevOps)
`,
      experience: () => `
<strong>[Mehnat Faoliyati]</strong>
• <strong>2025.05 → hozir:</strong> Senior Software Engineer · Ucell (Microservices, Oracle SQL, DevOps)
• <strong>2024.03 → hozir:</strong> Node.js Teacher · Najot Ta’lim (Backend, Databases, Deployment)
• <strong>2023.04 → hozir:</strong> Software Engineer · Namangan International School (Deno, grammY, Prisma)
• <strong>2022.02 → 2023.04:</strong> Software Engineer · Teclar Dev / Premium IT Solution (AWS, 3× response, 90% memory)
• <strong>2021.10 → 2022.02:</strong> Software Engineer Intern · Teclar Dev (Ajv, Playwright automation)
`,
      ping: () => `
PING xamidullo.uz (185.199.108.153): 56 data bytes
64 bytes from 185.199.108.153: icmp_seq=0 ttl=58 time=12.420 ms
64 bytes from 185.199.108.153: icmp_seq=1 ttl=58 time=11.894 ms
64 bytes from 185.199.108.153: icmp_seq=2 ttl=58 time=12.105 ms
--- xamidullo.uz ping statistics ---
3 packets transmitted, 3 packets received, 0.0% packet loss
round-trip min/avg/max = 11.894/12.139/12.420 ms (STATUS: OPTIMAL)
`,
      contact: () => `
<strong>[Aloqa Ma’lumotlari]</strong>
• Telegram: <a href="https://t.me/Xamidullo_Xudoyberdiyev" target="_blank">@Xamidullo_Xudoyberdiyev</a>
• Blog:     <a href="https://t.me/thelazy_programmer" target="_blank">@thelazy_programmer (The Lazy Programmer)</a>
• Email:    <a href="mailto:khkhamidullo@gmail.com">khkhamidullo@gmail.com</a>
• Telefon:  +998 94 611 00 66
• LinkedIn: <a href="https://www.linkedin.com/in/xam1dullo/" target="_blank">linkedin.com/in/xam1dullo</a>
• GitHub:   <a href="https://github.com/xam1dullo" target="_blank">github.com/xam1dullo</a>
`,
    };

    function openTerminal() {
      dialog.showModal();
      setTimeout(() => input.focus(), 80);
    }

    function closeTerminal() {
      dialog.close();
    }

    openBtn1?.addEventListener("click", openTerminal);
    openBtn2?.addEventListener("click", openTerminal);
    closeBtn?.addEventListener("click", closeTerminal);

    // Keyboard shortcut: Cmd+K or Ctrl+K
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dialog.open) closeTerminal();
        else openTerminal();
      }
    });

    // Light dismiss
    dialog.addEventListener("click", (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) closeTerminal();
    });

    // Execute command
    function executeCommand(rawCmd) {
      const cmd = rawCmd.trim().toLowerCase();
      if (!cmd) return;

      const userLine = document.createElement("div");
      userLine.className = "term-history-entry";
      userLine.innerHTML = `<span class="term-prompt">visitor@systems:~$</span> <span class="term-input-text">${escapeHtml(cmd)}</span>`;
      log.appendChild(userLine);

      if (cmd === "clear") {
        log.innerHTML = "";
      } else if (cmd === "exit") {
        closeTerminal();
      } else if (commands[cmd]) {
        const out = document.createElement("div");
        out.className = "term-output";
        out.innerHTML = commands[cmd]();
        log.appendChild(out);
      } else {
        const out = document.createElement("div");
        out.className = "term-output term-error";
        out.innerHTML = `zsh: buyruq topilmadi: ${escapeHtml(cmd)}. Mavjud buyruqlarni ko'rish uchun <span class="term-highlight">help</span> yozing.`;
        log.appendChild(out);
      }

      if (screen) {
        screen.scrollTop = screen.scrollHeight;
      }
    }

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const cmd = input.value;
      input.value = "";
      executeCommand(cmd);
    });

    // Quick command buttons
    document.querySelectorAll(".quick-cmd").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cmd = btn.getAttribute("data-cmd");
        if (cmd) executeCommand(cmd);
      });
    });

    function escapeHtml(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  })();
</script>

<style>
  .terminal-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-bright);
    background: var(--surface);
    color: var(--ink);
    inline-size: min(48rem, calc(100vw - 2rem));
    max-block-size: min(34rem, 85vh);
    border-radius: 1rem;
    box-shadow: 0 1.5rem 4rem rgb(var(--shadow-rgb) / 0.25);
    overflow: hidden;
  }

  .terminal-modal::backdrop {
    background: rgb(var(--shadow-rgb) / 0.5);
    backdrop-filter: blur(6px);
  }

  .terminal-shell {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    font-family: var(--mono);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: var(--surface-raised);
    border-block-end: 1px solid var(--line);
  }

  .terminal-dots {
    display: flex;
    gap: 0.4rem;
  }

  .dot {
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
  }

  .dot-red,
  .dot-yellow,
  .dot-green { background: var(--line-bright); }

  .terminal-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--ink-soft);
    letter-spacing: 0.05em;
  }

  .terminal-close-btn {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: -0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    color: var(--ink-faint);
    cursor: pointer;
    font-size: 0.9rem;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .terminal-close-btn:hover {
    background: rgb(var(--signal-rgb) / 0.08);
    border-color: var(--line-bright);
    color: var(--signal);
  }

  .terminal-screen {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    max-block-size: 22rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .ascii-art {
    margin: 0;
    color: var(--signal);
    font-size: 0.55rem;
    line-height: 1.15;
    opacity: 0.8;
  }

  .welcome-text {
    margin: 0.75rem 0 1.25rem;
    color: var(--ink-soft);
  }

  .term-highlight {
    color: var(--signal);
    font-weight: bold;
  }

  .term-green {
    color: var(--signal);
  }

  .terminal-input-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }

  .term-prompt {
    color: var(--signal-dim);
    font-weight: 600;
  }

  .terminal-input {
    flex: 1;
    background: none;
    border: none;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.85rem;
    outline: none;
  }

  .term-history-entry {
    margin-block-end: 0.35rem;
  }

  .term-input-text {
    color: var(--ink);
  }

  .term-output {
    margin-block-end: 0.75rem;
    color: var(--ink-soft);
  }

  .term-error {
    color: var(--danger);
  }

  .terminal-quick-cmds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1rem;
    background: var(--surface-raised);
    border-block-start: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  .quick-cmd {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    background: rgb(var(--signal-rgb) / 0.07);
    border: 1px solid var(--line-bright);
    color: var(--signal);
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, transform 120ms ease;
  }

  .quick-cmd:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-accent);
  }

  .quick-cmd:active {
    transform: scale(0.97);
  }
</style>
