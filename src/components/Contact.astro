---
import {
  ArrowUp01Icon,
  ArrowUpRight01Icon,
  Call02Icon,
  GithubIcon,
  Linkedin02Icon,
  Location01Icon,
  Mail01Icon,
  TelegramIcon,
} from "@hugeicons/core-free-icons";
import { defaultContent } from "../data/portfolio";
import HugeIcon from "./HugeIcon.astro";

const { contact } = defaultContent;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer reveal-on-scroll" id="contact">
  <div class="shell contact-card">
    <div class="contact-main">
      <p class="eyebrow" data-i18n="contact.eyebrow">{contact.eyebrow}</p>
      <h2 data-i18n="contact.title">{contact.title}</h2>
      <p data-i18n="contact.summary">{contact.summary}</p>

      <div class="contact-cta-row">
        <a
          class="button button-primary button-magnetic"
          href="https://t.me/Xamidullo_Xudoyberdiyev"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={TelegramIcon} size={17} anim="spark" />
          <span data-i18n="contact.telegramBtn">{contact.telegramBtn}</span>
          <HugeIcon icon={ArrowUpRight01Icon} size={15} anim="arrow-up-right" />
        </a>
        <a
          class="button button-secondary button-magnetic"
          href="https://www.linkedin.com/in/xam1dullo/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={Linkedin02Icon} size={17} anim="spark" />
          <span data-i18n="contact.linkedinBtn">{contact.linkedinBtn}</span>
          <HugeIcon icon={ArrowUpRight01Icon} size={15} anim="arrow-up-right" />
        </a>
      </div>
    </div>

    <address class="contact-details">
      <div class="contact-group">
        <span class="contact-lbl">// DIRECT CHANNELS</span>
        <a class="contact-row-link" href="mailto:khkhamidullo@gmail.com">
          <HugeIcon icon={Mail01Icon} size={15} anim="spark" />
          khkhamidullo@gmail.com
        </a>
        <a class="contact-row-link" href="tel:+998946110066">
          <HugeIcon icon={Call02Icon} size={15} anim="spark" />
          +998 94 611 00 66
        </a>
        <span class="contact-loc">
          <HugeIcon icon={Location01Icon} size={15} anim="float" />
          <span data-i18n="contact.location">{contact.location}</span>
        </span>
      </div>

      <div class="contact-group">
        <span class="contact-lbl">// PROFILES & BLOG</span>
        <a
          class="contact-row-link"
          href="https://t.me/Xamidullo_Xudoyberdiyev"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={TelegramIcon} size={15} anim="spark" />
          Telegram · @Xamidullo_Xudoyberdiyev
          <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
        </a>
        <a
          class="contact-row-link"
          href="https://t.me/thelazy_programmer"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={TelegramIcon} size={15} anim="spark" />
          Blog · The Lazy Programmer
          <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
        </a>
        <a
          class="contact-row-link"
          href="https://github.com/xam1dullo"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={GithubIcon} size={15} anim="spark" />
          GitHub · github.com/xam1dullo
          <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
        </a>
        <a
          class="contact-row-link"
          href="https://www.linkedin.com/in/xam1dullo/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <HugeIcon icon={Linkedin02Icon} size={15} anim="spark" />
          LinkedIn · in/xam1dullo
          <HugeIcon icon={ArrowUpRight01Icon} size={13} anim="arrow-up-right" />
        </a>
      </div>
    </address>
  </div>

  <div class="shell footer-bottom">
    <p class="footer-copy">
      © {currentYear} <strong>Xamidullo Xudoyberdiyev</strong> ·{" "}
      <span data-i18n="contact.footerNote">{contact.footerNote}</span>
    </p>
    <div class="footer-links">
      <a href="https://github.com/xam1dullo" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/xam1dullo/" target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
      <a href="https://t.me/thelazy_programmer" target="_blank" rel="noopener noreferrer">Blog</a>
      <a class="footer-top-link" href="#top">
        Yuqoriga
        <HugeIcon icon={ArrowUp01Icon} size={14} anim="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .contact-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block-start: 2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    padding-inline-start: clamp(0rem, 3vw, 2rem);
    border-inline-start: 1px solid var(--line);
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .contact-lbl {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    color: var(--signal-dim);
    margin-block-end: 0.2rem;
  }

  .contact-row-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .contact-loc {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.25rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .footer-copy {
    margin: 0;
  }

  .footer-copy strong {
    color: var(--ink);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a:hover {
    color: var(--signal);
  }

  @media (max-width: 44rem) {
    .contact-details {
      padding-inline-start: 0;
      padding-block-start: 1.5rem;
      border-inline-start: 0;
      border-block-start: 1px solid var(--line);
    }
  }
</style>
