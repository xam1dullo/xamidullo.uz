---
import { defaultContent } from "../data/portfolio";
const { contact } = defaultContent;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer reveal-on-scroll" id="contact">
  <div class="shell contact-card">
    <div class="contact-main">
      <p class="eyebrow" data-i18n="contact.eyebrow">{contact.eyebrow}</p>
      <h2 data-i18n="contact.title">{contact.title}</h2>
      <p data-i18n="contact.summary">{contact.summary}</p>

      <div class="contact-cta-row">
        <a
          class="button button-primary button-magnetic"
          href="https://t.me/Xamidullo_Xudoyberdiyev"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-i18n="contact.telegramBtn">{contact.telegramBtn}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button-secondary button-magnetic"
          href="https://www.linkedin.com/in/xam1dullo/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-i18n="contact.linkedinBtn">{contact.linkedinBtn}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <address class="contact-details">
      <div class="contact-group">
        <span class="contact-lbl">// DIRECT CHANNELS</span>
        <a href="mailto:khkhamidullo@gmail.com">khkhamidullo@gmail.com</a>
        <a href="tel:+998946110066">+998 94 611 00 66</a>
        <span class="contact-loc" data-i18n="contact.location">{contact.location}</span>
      </div>

      <div class="contact-group">
        <span class="contact-lbl">// PROFILES & BLOG</span>
        <a href="https://t.me/Xamidullo_Xudoyberdiyev" target="_blank" rel="noopener noreferrer">
          Telegram · @Xamidullo_Xudoyberdiyev ↗
        </a>
        <a href="https://t.me/thelazy_programmer" target="_blank" rel="noopener noreferrer">
          Blog · The Lazy Programmer ↗
        </a>
        <a href="https://github.com/xam1dullo" target="_blank" rel="noopener noreferrer">
          GitHub · github.com/xam1dullo ↗
        </a>
        <a href="https://www.linkedin.com/in/xam1dullo/" target="_blank" rel="noopener noreferrer">
          LinkedIn · in/xam1dullo ↗
        </a>
      </div>
    </address>
  </div>

  <div class="shell footer-bottom">
    <p class="footer-copy">
      © {currentYear} <strong>Xamidullo Xudoyberdiyev</strong> ·{" "}
      <span data-i18n="contact.footerNote">{contact.footerNote}</span>
    </p>
    <div class="footer-links">
      <a href="https://github.com/xam1dullo" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/xam1dullo/" target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
      <a href="https://t.me/thelazy_programmer" target="_blank" rel="noopener noreferrer">Blog</a>
      <a href="#top">Yuqoriga ↑</a>
    </div>
  </div>
</footer>

<style>
  .contact-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block-start: 2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    padding-inline-start: clamp(0rem, 3vw, 2rem);
    border-inline-start: 1px solid var(--line);
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .contact-lbl {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    color: var(--signal-dim);
    margin-block-end: 0.2rem;
  }

  .contact-loc {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.25rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .footer-copy {
    margin: 0;
  }

  .footer-copy strong {
    color: var(--ink);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-links a:hover {
    color: var(--signal);
  }

  @media (max-width: 44rem) {
    .contact-details {
      padding-inline-start: 0;
      padding-block-start: 1.5rem;
      border-inline-start: 0;
      border-block-start: 1px solid var(--line);
    }
  }
</style>
