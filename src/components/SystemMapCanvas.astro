<div class="system-map-container" aria-label="Tizim arxitekturasi interaktiv xaritasi">
  <canvas class="system-canvas" aria-hidden="true"></canvas>

  <div class="system-map-fallback sr-only">
    <h3>Tizim Nodelari</h3>
    <ul>
      <li>Markaziy Yadro: XH/SYSTEMS</li>
      <li>Backend: NestJS, Go, Deno</li>
      <li>Data: PostgreSQL, Oracle SQL, Redis</li>
      <li>Infra: Docker, AWS, CI/CD, Nginx</li>
      <li>Product: Next.js, UX, E2E</li>
    </ul>
  </div>

  <div class="canvas-hint" aria-hidden="true">
    <span>// INTERACTIVE TOPOLOGY MESH</span>
  </div>
</div>

<style>
  .system-map-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    min-block-size: 28rem;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .system-canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    cursor: crosshair;
  }

  .canvas-hint {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-start: 1.25rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    pointer-events: none;
    opacity: 0.85;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 62rem) {
    .system-map-container {
      min-block-size: 24rem;
    }
  }

  @media (max-width: 44rem) {
    .system-map-container {
      min-block-size: 20rem;
    }
  }
</style>
